  <!--
    The package smoke test restores the packed .nupkg from artifacts/, so as a project it would make the solution
    unbuildable until `dotnet pack` has run. Its files are listed here instead; CI builds and runs it after packing.
  -->
  <Folder Name="/tests/FancyEnumGenerator.PackageTests/">
    <File Path="tests/FancyEnumGenerator.PackageTests/FancyEnumGenerator.PackageTests.csproj" />
    <File Path="tests/FancyEnumGenerator.PackageTests/Enums.cs" />
    <File Path="tests/FancyEnumGenerator.PackageTests/Program.cs" />
